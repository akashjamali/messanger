{
  "expo": {
    "name": "MiFi Connect",
    "slug": "mifi-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./media/favicon_io/android-chrome-512x512.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./media/favicon_io/android-chrome-512x512.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./media/favicon_io/favicon.ico"
    },
    "sdkVersion": "57.0.0",
    "ios": {
      "icon": "./media/favicon_io/android-chrome-512x512.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.ttindern.mificonnect",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "This app requires local network access to connect to your MiFi router.",
        "NSContactsUsageDescription": "This app uses your saved contacts to show names on messages and to start a chat.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "extra": {
      "eas": {
        "projectId": "ec82eaae-0afd-484e-b2fd-1092fa7dea7b"
      }
    },
    "owner": "ttindern"
  }
}
