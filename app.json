{
  "expo": {
    "name": "Liquid Glass Chat",
    "slug": "liquid-glass-chat-ui",
    "scheme": "liquid-glass-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.appllama.liquidglasschat",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSContactsUsageDescription": "Liquid Glass Chat needs access to your contacts to show your conversations.",
        "NSLocalNetworkUsageDescription": "This app requires local network access to connect to your MiFi router.",
        "NSCameraUsageDescription": "Used for profile picture customization.",
        "NSPhotoLibraryUsageDescription": "Used to select contact profile photos.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-asset",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Liquid Glass Chat to access your contacts."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F2",
          "dark": {
            "backgroundColor": "#171819"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ],
      "expo-font"
    ],
    "platforms": ["ios"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
